# Base URL of the control API (the Render service), no trailing slash.
# Local development: http://localhost:8000
VITE_API_BASE_URL=

# Set to 1 to serve fake responses from src/services/mock.js (no backend needed).
# Never set this in the Vercel production environment.
VITE_MOCK=

# Mock mode only: simulated latency per request in ms (default 250).
# Set above 5000 to preview the "Waking the server" screen.
VITE_MOCK_DELAY_MS=

# Which deployment this is, for the Login trust line ("Protected by 2FA · Demo Mode"). demo (default) or live.
VITE_APP_MODE=
